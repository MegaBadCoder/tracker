BOT_TOKEN=
JWT_SECRET=
PORT=3002
NODE_ENV=production
DOMAIN=your-domain.com
REGISTRY_URL=registry.timeweb.cloud/your-repo
WEBAPP_URL=

# GitHub Actions (deploy.yml): secrets SMTP_ENV and S3_ENV — paste these blocks as multiline text (one secret per group).
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@yandex.ru
SMTP_PASS=your-app-password
EMAIL_FROM=Alfy <your-email@yandex.ru>

# S3-compatible storage (Timeweb / MinIO / AWS). Для прикреплённых файлов и прочих артефактов.
S3_ENDPOINT=https://s3.timeweb.cloud
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true
