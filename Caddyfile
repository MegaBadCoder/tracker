tracker.rocketup.tech {
	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy alfy-mcp:3003 {
			flush_interval -1
		}
	}

	@sse path /api/events /api/events/*
	handle @sse {
		reverse_proxy backend:3002 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	handle /api/* {
		reverse_proxy backend:3002
	}

	handle {
		reverse_proxy frontend:80
	}
}
